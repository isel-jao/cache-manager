{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ES2024"],

    "module": "nodenext",
    "rootDir": "./src",
    "types": ["node"],
    "resolveJsonModule": true,

    "declaration": true,
    "outDir": "./dist",

    "esModuleInterop": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
